.map-stage {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f5f7fa;
}

.map-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.floor-badge {
  position: absolute;
  z-index: 10;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 24rpx;
  background: rgba(31, 41, 55, 0.85);
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 999rpx;
}

.floor-switch {
  position: absolute;
  z-index: 10;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.floor-pill {
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #d1d5db;
  line-height: 88rpx;
}

.floor-pill.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}

.reset-btn {
  position: absolute;
  z-index: 10;
  right: 24rpx;
  bottom: 180rpx;
  width: 120rpx;
  margin: 0;
  padding: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f2937;
  border: 2rpx solid #d1d5db;
}

.overlay {
  position: absolute;
  z-index: 20;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: rgba(245, 247, 250, 0.92);
}

.overlay-text {
  color: #4b5563;
  font-size: 30rpx;
}

.retry-btn {
  margin: 0;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
}

/* ------------------------------------------------------------------
 * REQ-PAGE 单页化：下半屏按住说话热区 / 居中浮层 / 常驻设置入口
 * ------------------------------------------------------------------ */

/* 热区覆盖下半屏：透明不遮地图观感，状态胶囊悬浮提示；
   z-index 低于覆盖控件(10)与居中卡(30)，其上的控件点击与地图
   上半屏手势均不受影响 */
.ptt-zone {
  position: absolute;
  z-index: 5;
  left: 0;
  right: 0;
  top: 50%;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 140rpx;
}

.ptt-hint {
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.72);
  color: #ffffff;
  font-size: 30rpx;
}

.ptt-hint.recording {
  background: rgba(37, 99, 235, 0.9);
}

.ptt-hint.recognizing {
  background: rgba(5, 150, 105, 0.9);
}

.ptt-hint.error {
  background: rgba(185, 28, 28, 0.9);
}

/* 意图结果/候选/确认：屏幕居中卡片（REQ-PAGE） */
.center-card {
  position: absolute;
  z-index: 30;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  max-height: 70vh;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(31, 41, 55, 0.18);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 居中卡右上角关闭：随时收起反馈，不遮挡地图 */
.card-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  line-height: 64rpx;
  font-size: 30rpx;
  color: #6b7280;
  background: transparent;
  border: none;
  border-radius: 50%;
}

.center-card .row {
  font-size: 30rpx;
  color: #1f2937;
  line-height: 1.5;
}

.center-card .label {
  color: #6b7280;
  margin-right: 16rpx;
  font-size: 26rpx;
}

.center-card .fallback {
  color: #b45309;
  font-size: 26rpx;
}

.center-card .hint {
  color: #6b7280;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.center-card .candidate {
  margin: 0 0 12rpx 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #1d4ed8;
}

.center-card .primary {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  background: #2563eb;
  color: #ffffff;
}

/* 底端常驻设置入口（半透明小按钮，让位于 PTT 状态胶囊） */
.settings-btn {
  position: absolute;
  z-index: 10;
  left: 24rpx;
  bottom: 32rpx;
  margin: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  border: 2rpx solid #d1d5db;
}

/* ------------------------------------------------------------------
 * 导航 HUD（REQ-PAGE：导航态融合进地图页）
 * ------------------------------------------------------------------ */

.nav-hud {
  position: absolute;
  z-index: 30;
  left: 24rpx;
  right: 24rpx;
  top: 96rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  pointer-events: none; /* 仅子控件可点，避免大块遮挡地图手势 */
}

.nav-hud .nav-top,
.nav-hud .nav-instruction,
.nav-hud .nav-fallback,
.nav-hud .mock-hint,
.nav-hud .end-button,
.nav-hud .dismiss-button {
  pointer-events: auto;
}

.nav-top {
  padding: 20rpx 28rpx;
  background: rgba(31, 41, 55, 0.88);
  color: #ffffff;
  border-radius: 20rpx;
}

.nav-top .destination {
  font-size: 28rpx;
  opacity: 0.85;
}

.nav-top .state {
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.nav-instruction {
  padding: 24rpx 28rpx;
  background: #ffffff;
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 41, 55, 0.16);
}

.nav-fallback {
  padding: 16rpx 24rpx;
  background: rgba(255, 251, 235, 0.96);
  color: #b45309;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.nav-fallback .label {
  color: #92400e;
  margin-right: 12rpx;
}

.mock-hint {
  align-self: flex-start;
  padding: 8rpx 20rpx;
  background: rgba(5, 150, 105, 0.9);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.end-button {
  margin: 8rpx auto 0;
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: #b91c1c;
  color: #ffffff;
}

.dismiss-button {
  margin: 8rpx auto 0;
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
}
