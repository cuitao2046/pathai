.map-stage {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f5f7fa;
}

.map-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.floor-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 24rpx;
  background: rgba(31, 41, 55, 0.85);
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 999rpx;
}

.floor-switch {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.floor-pill {
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #d1d5db;
  line-height: 88rpx;
}

.floor-pill.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}

.reset-btn {
  position: absolute;
  right: 24rpx;
  bottom: 180rpx;
  width: 120rpx;
  margin: 0;
  padding: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f2937;
  border: 2rpx solid #d1d5db;
}

.overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: rgba(245, 247, 250, 0.92);
}

.overlay-text {
  color: #4b5563;
  font-size: 30rpx;
}

.retry-btn {
  margin: 0;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
}

.home-btn {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  margin: 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  background: #2563eb;
  color: #ffffff;
}
