<view class="map-stage">
  <!-- 手势绑在 canvas 自身：覆盖控件是 canvas 的兄弟节点，其 touch 序列
       不会进入手势流，规避 catchtouch 容器吞掉子元素 tap 的问题 -->
  <canvas
    type="2d"
    id="mapCanvas"
    class="map-canvas"
    catchtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    catchtouchend="onTouchEnd"
    catchtouchcancel="onTouchCancel"
  />

  <!-- 导航方向大箭头（仅视障模式）：箭头角 = 路线方位 − 手机朝向，
       箭头朝上 ⇔ 手机正对路线；偏离 >30° 持续 2s 转红 + 白描边。
       外框（衬底 / 参考环 / 环顶刻度）固定不转，只有内部转子 rotate：
       刻度始终代表「手机正前方」，用户可比较箭头与刻度判断是否对准。
       覆盖层 pointer-events:none，不拦截地图手势；z-index 20（HUD 30 之下） -->
  <view
    wx:if="{{arrowVisible}}"
    class="nav-arrow {{arrowDark ? 'nav-arrow--dark' : 'nav-arrow--light'}} {{arrowAlert ? 'nav-arrow--alert' : ''}}"
    style="transform: translate(-50%, -50%)"
    aria-hidden="true"
  >
    <view class="nav-arrow-ring"></view>
    <view class="nav-arrow-tick"></view>
    <view class="nav-arrow-rotor" style="transform: rotate({{arrowDeg}}deg)">
      <view
        class="nav-arrow-outline"
        style="clip-path:{{arrowClipPath}};-webkit-clip-path:{{arrowClipPath}}"
      ></view>
      <view
        class="nav-arrow-glyph"
        style="clip-path:{{arrowClipPath}};-webkit-clip-path:{{arrowClipPath}}"
      ></view>
    </view>
  </view>

  <!-- 左上角竖向工具条：设置 / 楼层选择（点击横向展开可选楼层）/ 全图。
       贴左边缘样式与采集页共用 styles/map-tools.wxss（.map-tools--left）：
       可视面贴画布左边界、右侧圆角左侧直角、热区不小于 36×36px；
       三枚按钮统一宽度 = 三者文案中最宽者（toolBtnWidth，页面按字体估算）；
       展开的楼层候选为绝对定位浮层，不影响设置/全图的位置。
       点按层用 <view aria-role="button">（不用 <button>：其内置 184px 默认宽会撑出间隙），
       展开后「触发键 + 候选」是一条零间隙、仅 1rpx 单线分隔的连续控件 -->
  <view class="map-tools map-tools--left top-left">
    <view
      class="zoom-hit"
      aria-role="button"
      bindtouchstart="onToolTouchStart"
      bindtap="onGoSettings"
      aria-label="打开设置"
    >
      <view class="zoom-face" style="width:{{toolBtnWidth}}rpx">设置</view>
    </view>

    <view class="floor-menu {{floorMenuOpen ? 'floor-menu--open' : ''}}" aria-label="楼层选择">
      <view
        class="zoom-hit"
        aria-role="button"
        bindtouchstart="onToolTouchStart"
        bindtap="onToggleFloorMenu"
        aria-label="楼层选择，当前{{currentFloorText}}"
        aria-expanded="{{floorMenuOpen}}"
      ><view class="zoom-face floor-current" style="width:{{toolBtnWidth}}rpx">{{currentFloorText}}</view></view>
      <view class="floor-options" wx:if="{{floorMenuOpen}}">
        <view
          wx:for="{{floors}}"
          wx:key="floorId"
          class="zoom-hit"
          aria-role="button"
          data-floor="{{item.floorId}}"
          bindtouchstart="onToolTouchStart"
          bindtap="onSwitchFloor"
          aria-label="切换到{{item.displayName}}"
          aria-pressed="{{item.floorId === currentFloor}}"
        ><view
          class="zoom-face floor-pill {{index === floors.length - 1 ? 'floor-opt-last' : ''}} {{item.floorId === currentFloor ? 'active' : ''}}"
          style="width:{{toolBtnWidth}}rpx"
        >{{item.level}}F</view></view>
      </view>
    </view>

    <view class="zoom-hit" aria-role="button" bindtap="onResetView" aria-label="回到全图">
      <view class="zoom-face" style="width:{{toolBtnWidth}}rpx">全图</view>
    </view>

    <!-- 第 4 颗：现场采集工具（设置页开关控制显隐，导航中隐藏）。
         结构与交互同楼层菜单——触发键右侧横向展开两个连体候选；
         隐藏时整颗移除，前三颗的间距与圆角不受影响 -->
    <view
      class="collect-menu {{collectMenuOpen ? 'collect-menu--open' : ''}}"
      wx:if="{{collectEntry && !navActive}}"
      aria-label="现场采集工具"
    >
      <view
        class="zoom-hit"
        aria-role="button"
        bindtouchstart="onToolTouchStart"
        bindtap="onToggleCollectMenu"
        aria-label="现场采集工具"
        aria-expanded="{{collectMenuOpen}}"
      ><view class="zoom-face collect-current" style="width:{{toolBtnWidth}}rpx">采集</view></view>
      <view class="collect-options" wx:if="{{collectMenuOpen}}">
        <view
          class="zoom-hit"
          aria-role="button"
          bindtap="onGoCollectStatic"
          aria-label="打开静态标定采集"
        ><view class="zoom-face collect-pill" style="width:{{collectOptWidth}}rpx">静态标定</view></view>
        <view
          class="zoom-hit"
          aria-role="button"
          bindtap="onGoCollectFingerprint"
          aria-label="打开网格指纹采集"
        ><view class="zoom-face collect-pill collect-opt-last" style="width:{{collectOptWidth}}rpx">网格指纹</view></view>
      </view>
    </view>
  </view>

  <!-- 意图结果/候选/确认：屏幕居中浮层（REQ-PAGE；导航态时让位给导航 HUD） -->
  <view
    class="center-card"
    wx:if="{{!navActive && (recognized !== '' || reply !== '' || partial !== '' || fallbackText !== '' || candidates.length > 0 || destination !== null)}}"
  >
    <button
      class="card-close"
      bindtap="onDismissIntent"
      aria-label="关闭提示"
    >✕</button>
    <view class="row" wx:if="{{partial !== ''}}"><text class="label">识别中</text><text>{{partial}}</text></view>
    <view class="row" wx:if="{{recognized !== ''}}"><text class="label">你说</text><text>{{recognized}}</text></view>
    <view class="row" wx:if="{{reply !== ''}}"><text class="label">助手</text><text user-select>{{reply}}</text></view>
    <view class="row fallback" wx:if="{{fallbackText !== ''}}">
      <text class="label">文字提示</text><text user-select>{{fallbackText}}</text>
    </view>

    <view class="candidates" wx:if="{{candidates.length > 0}}">
      <view class="hint">你想去哪一个？</view>
      <button
        wx:for="{{candidates}}"
        wx:key="placeId"
        class="candidate"
        bindtap="onPickCandidate"
        data-name="{{item.name}}"
        aria-label="选择{{item.name}}"
      >{{item.name}}（{{item.floorId}}）</button>
    </view>

    <button
      wx:if="{{destination !== null}}"
      class="primary"
      bindtap="onStartNav"
      aria-label="开始导航到{{destination.name}}"
    >开始导航：{{destination.name}}</button>
  </view>

  <!-- 导航 HUD（REQ-PAGE：导航态融合进地图页；原独立导航页退役） -->
  <view class="nav-hud" wx:if="{{navActive}}">
    <view class="nav-top">
      <view class="destination">目的地：{{destinationName}}</view>
      <view class="state" aria-live="polite">{{stateText}}</view>
    </view>

    <view class="nav-instruction" aria-live="assertive" wx:if="{{instruction !== ''}}">{{instruction}}</view>

    <view class="nav-fallback" wx:if="{{fallbackText !== ''}}">
      <text class="label">文字提示</text>
      <text user-select>{{fallbackText}}</text>
    </view>

    <view class="mock-hint" wx:if="{{isMockSource && !ended}}">mock 模式：使用模拟信标轨迹定位</view>

    <button
      wx:if="{{!ended}}"
      class="end-button"
      bindtap="onEndTap"
      aria-label="结束导航，双击确认"
    >结束导航</button>
    <button wx:else class="dismiss-button" bindtap="onDismissNav" aria-label="关闭导航结果">关闭</button>
  </view>

  <!-- 按住说话按钮：屏幕下端居中（视觉为按钮，命中区同尺寸放大） -->
  <view
    class="ptt-zone {{pttState}}"
    bindtouchstart="onPttStart"
    bindtouchend="onPttEnd"
    bindtouchcancel="onPttCancel"
    aria-label="按住说话，松开结束"
    aria-disabled="{{!mapReady}}"
  >
    <text class="ptt-hint {{pttState}}">{{pttStateText}}</text>
  </view>

  <view class="overlay" wx:if="{{loading}}">
    <text class="overlay-text">{{loadError !== '' ? loadError : '正在加载地图…'}}</text>
    <button class="retry-btn" wx:if="{{loadError !== ''}}" bindtap="onRetry">重试</button>
  </view>
</view>
