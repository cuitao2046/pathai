<view class="map-stage">
  <!-- 手势绑在 canvas 自身：覆盖控件是 canvas 的兄弟节点，其 touch 序列
       不会进入手势流，规避 catchtouch 容器吞掉子元素 tap 的问题 -->
  <canvas
    type="2d"
    id="mapCanvas"
    class="map-canvas"
    catchtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    catchtouchend="onTouchEnd"
    catchtouchcancel="onTouchCancel"
  />

  <!-- 左上角竖向工具条：设置 / 楼层选择（点击横向展开可选楼层）/ 全图，
       三枚按钮同尺寸；楼层选择按钮常显当前楼层 -->
  <view class="top-left">
    <button class="tool-btn" bindtap="onGoSettings" aria-label="打开设置">设置</button>

    <view class="floor-menu" aria-label="楼层选择">
      <button
        class="tool-btn floor-current"
        bindtap="onToggleFloorMenu"
        aria-label="楼层选择，当前{{currentFloorText}}"
        aria-expanded="{{floorMenuOpen}}"
      >{{currentFloorText}}</button>
      <block wx:if="{{floorMenuOpen}}">
        <button
          wx:for="{{floors}}"
          wx:key="floorId"
          class="tool-btn floor-pill {{item.floorId === currentFloor ? 'active' : ''}}"
          data-floor="{{item.floorId}}"
          bindtap="onSwitchFloor"
          aria-label="切换到{{item.displayName}}"
          aria-pressed="{{item.floorId === currentFloor}}"
        >{{item.level}}F</button>
      </block>
    </view>

    <button class="tool-btn" bindtap="onResetView" aria-label="回到全图">全图</button>
  </view>

  <!-- 意图结果/候选/确认：屏幕居中浮层（REQ-PAGE；导航态时让位给导航 HUD） -->
  <view
    class="center-card"
    wx:if="{{!navActive && (recognized !== '' || reply !== '' || partial !== '' || fallbackText !== '' || candidates.length > 0 || destination !== null)}}"
  >
    <button
      class="card-close"
      bindtap="onDismissIntent"
      aria-label="关闭提示"
    >✕</button>
    <view class="row" wx:if="{{partial !== ''}}"><text class="label">识别中</text><text>{{partial}}</text></view>
    <view class="row" wx:if="{{recognized !== ''}}"><text class="label">你说</text><text>{{recognized}}</text></view>
    <view class="row" wx:if="{{reply !== ''}}"><text class="label">助手</text><text user-select>{{reply}}</text></view>
    <view class="row fallback" wx:if="{{fallbackText !== ''}}">
      <text class="label">文字提示</text><text user-select>{{fallbackText}}</text>
    </view>

    <view class="candidates" wx:if="{{candidates.length > 0}}">
      <view class="hint">你想去哪一个？</view>
      <button
        wx:for="{{candidates}}"
        wx:key="placeId"
        class="candidate"
        bindtap="onPickCandidate"
        data-name="{{item.name}}"
        aria-label="选择{{item.name}}"
      >{{item.name}}（{{item.floorId}}）</button>
    </view>

    <button
      wx:if="{{destination !== null}}"
      class="primary"
      bindtap="onStartNav"
      aria-label="开始导航到{{destination.name}}"
    >开始导航：{{destination.name}}</button>
  </view>

  <!-- 导航 HUD（REQ-PAGE：导航态融合进地图页；原独立导航页退役） -->
  <view class="nav-hud" wx:if="{{navActive}}">
    <view class="nav-top">
      <view class="destination">目的地：{{destinationName}}</view>
      <view class="state" aria-live="polite">{{stateText}}</view>
    </view>

    <view class="nav-instruction" aria-live="assertive" wx:if="{{instruction !== ''}}">{{instruction}}</view>

    <view class="nav-fallback" wx:if="{{fallbackText !== ''}}">
      <text class="label">文字提示</text>
      <text user-select>{{fallbackText}}</text>
    </view>

    <view class="mock-hint" wx:if="{{isMockSource && !ended}}">mock 模式：使用模拟信标轨迹定位</view>

    <button
      wx:if="{{!ended}}"
      class="end-button"
      bindtap="onEndTap"
      aria-label="结束导航，双击确认"
    >结束导航</button>
    <button wx:else class="dismiss-button" bindtap="onDismissNav" aria-label="关闭导航结果">关闭</button>
  </view>

  <!-- 按住说话按钮：屏幕下端居中（视觉为按钮，命中区同尺寸放大） -->
  <view
    class="ptt-zone {{pttState}}"
    bindtouchstart="onPttStart"
    bindtouchend="onPttEnd"
    bindtouchcancel="onPttCancel"
    aria-label="按住说话，松开结束"
    aria-disabled="{{!mapReady}}"
  >
    <text class="ptt-hint {{pttState}}">{{pttStateText}}</text>
  </view>

  <view class="overlay" wx:if="{{loading}}">
    <text class="overlay-text">{{loadError !== '' ? loadError : '正在加载地图…'}}</text>
    <button class="retry-btn" wx:if="{{loadError !== ''}}" bindtap="onRetry">重试</button>
  </view>
</view>
