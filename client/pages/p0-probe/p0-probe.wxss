.page {
  min-height: 100vh;
  padding: 36rpx;
  box-sizing: border-box;
  background: #f0f4f8;
  color: #172b4d;
}

.card {
  padding: 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.hint {
  font-size: 27rpx;
  line-height: 1.65;
  color: #425466;
}

.probe-button {
  margin: 40rpx 0 24rpx;
  background: #174ea6;
  color: #ffffff;
}

.result {
  margin: 20rpx 0 36rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #eaf2ff;
  font-size: 30rpx;
  line-height: 1.6;
}
