.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.destination {
  font-size: 32rpx;
  color: #4b5563;
}

.state {
  font-size: 28rpx;
  color: #6b7280;
}

.instruction-card {
  margin-top: 48rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #eef4ff;
}

.instruction {
  font-size: 44rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #111827;
}

.fallback {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  line-height: 1.6;
  color: #374151;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  font-size: 24rpx;
  color: #9ca3af;
}

.mock-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}

.end-button {
  margin-top: auto;
  background: #dc2626;
  color: #ffffff;
  font-size: 36rpx;
  border-radius: 48rpx;
}

.back-button {
  margin-top: auto;
  background: #2563eb;
  color: #ffffff;
  font-size: 36rpx;
  border-radius: 48rpx;
}
