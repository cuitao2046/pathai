.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f4f6f8;
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.label {
  flex: 0 0 210rpx;
  color: #6b7280;
}

.flex-text {
  flex: 1;
  margin-left: 16rpx;
  word-break: break-all;
  text-align: right;
}

.value-strong {
  font-weight: 600;
}

.hint {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #6b7280;
}

.sub-title {
  margin: 24rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.sample-item {
  margin-top: 12rpx;
  padding: 18rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fafafa;
}

.sample-item-active {
  border-color: #2563eb;
  background: #eff6ff;
}

.sample-name {
  font-size: 24rpx;
  color: #111827;
  word-break: break-all;
}

.sample-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.ok-text {
  color: #15803d;
}

.warn-text {
  color: #b45309;
}

.file-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: #374151;
}

.file-flag {
  flex: 0 0 36rpx;
  font-weight: 700;
}

.file-name {
  flex: 0 0 220rpx;
  word-break: break-all;
}

.file-path {
  flex: 1;
  color: #6b7280;
  word-break: break-all;
}

.warn-line {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #b45309;
}

.action {
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
}

.action[disabled] {
  background: #cbd5e1 !important;
  color: #ffffff !important;
}

.action.secondary {
  background: #e5e7eb;
  color: #111827;
}

.action.danger {
  background: #b91c1c;
}

.state-card {
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 8rpx solid #2563eb;
  background: #eff6ff;
}

.state-card.tone-ready {
  border-left-color: #0d9488;
  background: #f0fdfa;
}

.state-card.tone-success {
  border-left-color: #15803d;
  background: #f0fdf4;
}

.state-card.tone-warn {
  border-left-color: #b45309;
  background: #fffbeb;
}

.state-card.tone-error {
  border-left-color: #b91c1c;
  background: #fef2f2;
}

.state-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.state-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4b5563;
  word-break: break-all;
}

.version-line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.version-line:last-of-type {
  border-bottom: none;
}

.version-active {
  background: #f0fdf4;
}

.version-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.version-flag {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #15803d;
  color: #ffffff;
  font-size: 20rpx;
}

.version-body {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6b7280;
  word-break: break-all;
}
