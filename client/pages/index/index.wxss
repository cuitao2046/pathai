.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.hero {
  margin: 120rpx 0 80rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1f2937;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.primary {
  margin-top: 32rpx;
}

.hint {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}
