@import "../../../styles/map-tools.wxss";

.field-page { padding: 20rpx 24rpx 48rpx; }
.tabs, .row { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.tabs { margin-bottom: 16rpx; flex-wrap: wrap; }
.tabs button { flex: 1 0 40%; margin: 0; font-size: 25rpx; background: #e9edf4; }
.tabs .selected, .primary { color: #fff; background: #1a56db; }
.panel, .beacon { background: #fff; border-radius: 16rpx; margin: 0 0 16rpx; padding: 22rpx; }
.panel button { margin-top: 14rpx; }
.beacon { width: 100%; line-height: 1.55; text-align: left; }
.select, input, textarea { box-sizing: border-box; width: 100%; min-height: 72rpx; margin: 10rpx 0; padding: 16rpx; background: #eef2f7; border-radius: 10rpx; }
textarea { height: 140rpx; }
.fields input { flex: 1; min-width: 0; }
.fingerprint-build { margin-top: 20rpx; }
.fingerprint-build-plan { display: flex; align-items: center; gap: 10rpx; min-height: 72rpx; }
.muted { color: #475569; font-size: 25rpx; }
.notice { color: #854d0e; background: #fef3c7; border-radius: 12rpx; margin: 0 0 16rpx; padding: 16rpx; }
.secondary { color: #173265; background: #e8effc; }
.countdown { font-size: 64rpx; font-weight: 700; text-align: center; }
.mark { min-height: 164rpx; line-height: 164rpx; font-size: 48rpx; }
.seen { color: #166534; }
.not-seen { color: #991b1b; }
.result { white-space: pre-wrap; }
.calibration-row {
  display: grid;
  grid-template-columns: 1.15fr 1fr 1fr;
  gap: 12rpx;
  padding: 10rpx 0;
  font-variant-numeric: tabular-nums;
}
.point-map-panel { padding: 16rpx; }
.point-map-caption { padding: 0 4rpx 12rpx; font-size: 26rpx; }
.point-map-wrap { position: relative; overflow: hidden; border-radius: 12rpx; background: #eef2f7; }
.point-map { display: block; width: 100%; height: 68vh; }
.point-map-tools { top: 24rpx; }
.point-map-tools .zoom-face { width: 80rpx; }
.point-map-floors button, .point-menu-close {
  margin: 0;
  padding: 0 16rpx;
  min-width: 72rpx;
  min-height: 64rpx;
  font-size: 24rpx;
}
.point-map-floors { display: flex; gap: 12rpx; margin-top: 12rpx; }
.point-menu {
  position: fixed;
  z-index: 10;
  right: 0;
  left: 0;
  bottom: 0;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -5rpx 22rpx rgba(15, 23, 42, 0.16);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.point-menu-title { color: #172554; font-size: 31rpx; font-weight: 700; }
.point-wall { padding: 8rpx 0; font-size: 25rpx; }
.wall-a { color: #9d174d; }
.wall-b { color: #0f766e; }
.point-menu-actions { margin-top: 14rpx; }
.point-menu-actions button { flex: 1; margin: 0; }
.point-menu-space { height: 300rpx; }
