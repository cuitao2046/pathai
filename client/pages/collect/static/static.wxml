<view class="page">
  <!-- 顶栏：楼层 / 倒计时档位 / 导出 -->
  <view class="topbar">
    <view class="floor-pills" aria-label="楼层选择">
      <button
        wx:for="{{floors}}"
        wx:key="floorId"
        class="pill {{item.floorId === currentFloor ? 'active' : ''}}"
        data-floor="{{item.floorId}}"
        bindtap="onSwitchFloor"
        aria-label="切换到{{item.displayName}}"
      >{{item.level}}F</button>
    </view>
    <picker
      mode="selector"
      range="{{durationOptions}}"
      value="{{durationIndex}}"
      bindchange="onDurationChange"
      aria-label="采集倒计时时长"
    >
      <button class="pill" aria-label="倒计时时长{{durationS}}秒">倒计时 {{durationS}}s</button>
    </picker>
    <button class="pill" bindtap="onExport" aria-label="导出采集记录">导出</button>
  </view>

  <view class="stats-bar" aria-live="polite">
    <text>点位 {{stats.pointCount}} · 已采 {{stats.sampledPointCount}} · 会话 {{stats.sessionCount}}</text>
    <text class="legend">蓝=待采 绿=已采</text>
  </view>

  <view class="mock-hint" wx:if="{{isMock}}">mock 模式：模拟信标轨迹，数据仅供联调</view>

  <!-- 地图画布（手势与长按补标） -->
  <canvas
    type="2d"
    id="collectCanvas"
    class="collect-canvas"
    catchtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    catchtouchend="onTouchEnd"
    catchtouchcancel="onTouchCancel"
    bindlongpress="onLongPressEvent"
    aria-label="标定点位地图，长按可补标点位"
  />

  <!-- 缩放控件：单指精细调整（双指缩放之外的补充）；显式 z-index 保证可点按 -->
  <view class="map-tools" aria-label="地图缩放控制">
    <button class="zoom-btn" bindtap="onZoomIn" aria-label="放大地图">＋</button>
    <button class="zoom-btn" bindtap="onZoomOut" aria-label="缩小地图">－</button>
    <button class="zoom-btn zoom-reset" bindtap="onResetView" aria-label="回到全图">全图</button>
  </view>

  <!-- 采集中：倒计时 + 实时窗口表 -->
  <view class="collect-panel" wx:if="{{collecting}}" aria-live="polite">
    <view class="countdown-row">
      <text class="countdown">{{countdownText}}</text>
      <text class="meta">样本 {{sampleCount}} · 信标 {{beaconCount}}</text>
    </view>
    <view class="no-sample" wx:if="{{noSampleHint}}">未收到 BLE 样本，请检查手机蓝牙后保持原地</view>
    <view class="obs-table" wx:if="{{obsRows.length > 0}}">
      <view class="obs-row obs-head">
        <text>信标</text><text>样本数</text><text>中位数 dBm</text>
      </view>
      <view class="obs-row" wx:for="{{obsRows}}" wx:key="beaconId">
        <text>{{item.beaconId}}</text><text>{{item.n}}</text><text>{{item.rssiMedian}}</text>
      </view>
    </view>
  </view>

  <!-- 点位确认卡 -->
  <view class="card-mask" wx:if="{{card !== null}}" bindtap="onCardCancel">
    <view class="card" catchtap="noop" aria-label="点位确认">
      <view class="card-title">{{card.pointId}}</view>
      <view class="card-row"><text class="label">场景</text><text>{{card.sceneText}}</text></view>
      <view class="card-row"><text class="label">楼层</text><text>{{card.floorText}}</text></view>
      <view class="card-row"><text class="label">真值坐标</text><text>{{card.truthText}}</text></view>
      <view class="card-row"><text class="label">已采次数</text><text>{{card.sessionCount}}</text></view>
      <view class="card-row"><text class="label">定位距离</text><text>{{card.distanceText}}</text></view>
      <view class="card-hint">请通过门牌/墙角/柱子等现场参照物确认已到达点位；确认后开始倒计时采集，期间请原地站立。</view>
      <view class="card-actions">
        <button class="btn ghost" bindtap="onCardCancel" aria-label="取消">取消</button>
        <button class="btn ghost" bindtap="onManageSessions" aria-label="会话与点位管理">管理</button>
        <button class="btn primary" bindtap="onCardConfirm" aria-label="确认到点，开始采集">确认采集</button>
      </view>
    </view>
  </view>

  <view class="overlay" wx:if="{{loading}}">
    <text class="overlay-text">{{loadError !== '' ? loadError : '正在加载地图…'}}</text>
    <button class="retry-btn" wx:if="{{loadError !== ''}}" bindtap="onRetry">重试</button>
  </view>
</view>
