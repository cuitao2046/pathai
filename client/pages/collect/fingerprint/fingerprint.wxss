/* 网格指纹采集页样式（与静态标定页同一套布局语言） */
@import "../../../styles/map-tools.wxss";

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eef3f8;
}

/* 筛选档位按钮（楼层/导出已移到右下操作列，此基础样式仅服务 .pill.filter） */
.pill {
  margin: 0;
  padding: 0 22rpx;
  height: 60rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #1f2937;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #cbd5e1;
  border-radius: 30rpx;
}

.pill.active {
  background: #1a56db;
  border-color: #1a56db;
  color: #ffffff;
}

.stats-bar {
  position: absolute;
  top: 16rpx;
  left: 24rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 22rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.stats-sub {
  font-size: 18rpx;
  color: #64748b;
}

/* 覆盖层降级提示：贴底部操作列上方，避免遮挡顶部图例 */
.grid-notice {
  position: absolute;
  bottom: 190rpx;
  left: 24rpx;
  /* 与静态标定页一致：右侧让出右下操作列宽度，避免被按钮压住 */
  right: 130rpx;
  z-index: 4;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #f59e0b;
  background: rgba(255, 251, 235, 0.95);
  font-size: 20rpx;
  line-height: 1.4;
  color: #92400e;
}

.legend-bar {
  position: absolute;
  /* 顶栏移走后统计栏上移到 16rpx，图例相应上移，避免重叠 */
  top: 86rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
}

.legend-items {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
}

/* 路线点：蓝色实心 + 橙色描边（橙色只表示“优先”，不再占用填充色） */
.dot.route {
  background: #2563eb;
  border: 2rpx solid #f97316;
}

.dot.collectable {
  background: #2563eb;
}

.dot.blind {
  border: 1rpx solid #94a3b8;
  background: transparent;
}

.dot.done {
  background: #16a34a;
}

/* 补装仿真点：紫色虚线空心（与 v11 真实可采的蓝实心区分） */
.dot.sim {
  border: 1rpx dashed #8e24aa;
  background: transparent;
}

/* 含虚拟信标预览提示条（仅开关打开时渲染） */
.sim-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #6b21a8;
}

.sim-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(142, 36, 170, 0.12);
  border: 1rpx solid rgba(142, 36, 170, 0.45);
  font-weight: 600;
}

.sim-text {
  color: #7e22ce;
}

.filter-group {
  display: flex;
  gap: 10rpx;
}

.pill.filter {
  height: 44rpx;
  line-height: 40rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.mock-hint {
  position: absolute;
  top: 276rpx;
  left: 24rpx;
  z-index: 3;
  font-size: 22rpx;
  color: #b45309;
  background: rgba(254, 243, 199, 0.95);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.collect-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* 缩放控件：共享样式见 styles/map-tools.wxss；此处只定位到图例下方（保持原位不动） */
.map-tools {
  top: 300rpx;
}

/* 操作按键列：楼层切换 + 导出，贴屏幕右下边缘垂直一列（贴右、贴下）。
 * 可视面随文字宽度（min 56rpx），点按热区高度 72rpx（36 CSS px）满足既有无障碍下限。 */
.op-tools {
  position: absolute;
  right: 0;
  bottom: 24rpx;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.op-btn {
  box-sizing: border-box;
  min-width: 56rpx;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1f2937;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #cbd5e1;
  border-right: none;
  border-radius: 14rpx 0 0 14rpx;
}

/* 入库前置条件未满足（有未导出记录）或正在入库：视觉弱化，点击仍给出原因提示 */
.op-btn.disabled {
  color: #94a3b8;
  background: rgba(241, 245, 249, 0.92);
}

.op-btn.active {
  background: #1a56db;
  border-color: #1a56db;
  color: #ffffff;
}

/* 危险操作（清理记录）：与楼层/导出同列，红字弱化，靠列顶远离拇指误触 */
.op-btn.danger {
  color: #b91c1c;
  border-color: #fca5a5;
}

/* 快照倒计时：屏幕底部居中（贴下），与右下操作列留出间距 */
.countdown-hud {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  transform: translateX(-50%);
  z-index: 4;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  max-width: calc(100% - 260rpx);
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.18);
}

.countdown {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a56db;
}

.meta {
  font-size: 24rpx;
  color: #475569;
}

/* 确认卡 */
.card-mask {
  position: absolute;
  inset: 0;
  z-index: 6;
  background: rgba(15, 23, 42, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card {
  width: 560rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.card-row {
  display: flex;
  font-size: 26rpx;
  padding: 6rpx 0;
  color: #1f2937;
}

.card-row .label {
  width: 160rpx;
  color: #64748b;
}

.card-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b45309;
  background: #fffbeb;
  border-radius: 8rpx;
  padding: 12rpx;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  border-radius: 12rpx;
  line-height: 2.4;
}

.btn.primary {
  background: #1a56db;
  color: #ffffff;
}

.btn.ghost {
  background: #f1f5f9;
  color: #1f2937;
}

/* 加载/错误浮层 */
.overlay {
  position: absolute;
  inset: 0;
  z-index: 8;
  background: #eef3f8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.overlay-text {
  font-size: 28rpx;
  color: #475569;
  padding: 0 48rpx;
  text-align: center;
}

.retry-btn {
  background: #1a56db;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 48rpx;
}
