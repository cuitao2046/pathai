/* 蓝牙部署点位页：全屏地图 + 底部点位/参考墙信息卡 */
@import "../../../styles/map-tools.wxss";
@import "../../../styles/collect-card.wxss";

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eef3f8;
}

.hint-bar {
  position: absolute;
  top: 16rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 3;
  font-size: 22rpx;
  line-height: 1.4;
  color: #475569;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
}

.deploy-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.map-tools {
  top: 96rpx;
}

/* 楼层切换：贴屏幕右下边缘垂直排列（与静态标定页一致） */
.op-tools {
  position: absolute;
  right: 0;
  bottom: 24rpx;
  bottom: calc(24rpx + constant(safe-area-inset-bottom));
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.op-btn {
  box-sizing: border-box;
  min-width: 56rpx;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1f2937;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #cbd5e1;
  border-right: none;
  border-radius: 14rpx 0 0 14rpx;
}

.op-btn.active {
  background: #1a56db;
  border-color: #1a56db;
  color: #ffffff;
}

/* 参考墙左右侧标识：与地图上的墙面高亮同色 */
.card-row .label.ref-left {
  color: #9d174d;
}

.card-row .label.ref-right {
  color: #0f766e;
}

/* 加载/错误浮层 */
.overlay {
  position: absolute;
  inset: 0;
  z-index: 8;
  background: #eef3f8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.overlay-text {
  font-size: 28rpx;
  color: #475569;
  padding: 0 48rpx;
  text-align: center;
}

.retry-btn {
  background: #1a56db;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 48rpx;
}
