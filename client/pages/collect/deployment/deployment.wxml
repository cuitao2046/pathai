<view class="page">
  <view class="hint-bar" wx:if="{{!loading && loadError === ''}}">
    点击地图上的信标点位，查看点位信息与参考测距墙面
  </view>

  <canvas
    type="2d"
    id="deploymentCanvas"
    class="deploy-canvas"
    catchtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    catchtouchend="onTouchEnd"
    catchtouchcancel="onTouchCancel"
    aria-label="蓝牙部署点位地图，点击信标查看参考测距墙面"
  />

  <view class="map-tools" aria-label="地图缩放控制">
    <view class="zoom-hit" aria-role="button" bindtap="onZoomIn" aria-label="放大地图"><view class="zoom-face">＋</view></view>
    <view class="zoom-hit" aria-role="button" bindtap="onZoomOut" aria-label="缩小地图"><view class="zoom-face">－</view></view>
    <view class="zoom-hit zoom-reset" aria-role="button" bindtap="onResetView" aria-label="回到全图"><view class="zoom-face">全图</view></view>
  </view>

  <view class="op-tools" aria-label="楼层切换">
    <view
      wx:for="{{floors}}"
      wx:key="floorId"
      class="op-btn {{item.floorId === currentFloor ? 'active' : ''}}"
      data-floor="{{item.floorId}}"
      bindtap="onSwitchFloor"
      aria-role="button"
      aria-label="切换到{{item.displayName}}"
    >{{item.level}}F</view>
  </view>

  <view class="card" wx:if="{{selected !== null}}" aria-label="点位部署信息">
    <view class="card-title">{{selected.beaconId}}</view>
    <view class="card-row"><text class="label">楼层</text><text>{{selected.floorText}}</text></view>
    <view class="card-row"><text class="label">坐标</text><text>{{selected.coordText}}</text></view>
    <view class="card-row"><text class="label">安装高度</text><text>{{selected.heightText}}</text></view>
    <view class="card-row" wx:if="{{selected.locationDesc}}"><text class="label">位置</text><text>{{selected.locationDesc}}</text></view>
    <view class="card-row"><text class="label">安装墙面</text><text>{{selected.installWallText}}</text></view>
    <view class="card-row" wx:for="{{selected.walls}}" wx:key="key">
      <text class="label {{item.sideClass}}">参考墙·{{item.sideText}}</text>
      <text>{{item.wallId}} · 垂直距离 {{item.distanceText}} m</text>
    </view>
    <view class="card-hint" wx:if="{{selected.wallHint}}">{{selected.wallHint}}</view>
    <view class="card-actions">
      <button class="btn ghost" bindtap="onCloseCard" aria-label="关闭点位信息">关闭</button>
    </view>
  </view>

  <view class="overlay" wx:if="{{loading || loadError !== ''}}">
    <text class="overlay-text">{{loadError !== '' ? loadError : '正在加载地图…'}}</text>
    <button class="retry-btn" wx:if="{{loadError !== ''}}" bindtap="onRetry">重试</button>
  </view>
</view>
