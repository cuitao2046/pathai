<view class="page">
  <view class="section">
    <view class="section-title">联调配置</view>
    <view class="row"><text class="label">API 地址</text><text user-select>{{apiUrl}}</text></view>
    <view class="row"><text class="label">站点</text><text>{{siteId}}</text></view>
    <view class="row">
      <text class="label">真实信标（live）</text>
      <switch checked="{{dataSource === 'live'}}" bindchange="onChangeDataSource" aria-label="切换数据源为真实信标扫描" />
    </view>
    <view class="hint">关闭=mock 模拟轨迹（开发者工具）；开启=真机 BLE 实扫。切换后重启小程序生效。</view>

    <view class="row">
      <text class="label">语音使用 mock（ASR+TTS）</text>
      <switch checked="{{voiceMock}}" bindchange="onChangeVoiceMock" aria-label="切换语音交互是否使用模拟数据" />
    </view>
    <view class="hint">开启=Mock 引擎（模拟识别文本、无声音）；<text style="color:#b91c1c">关闭=ASR 与 TTS 真实调用讯飞 API</text>（需网络与 socket 合法域名）。切换后重启小程序生效。</view>

    <block wx:if="{{voiceMock}}">
      <view class="row">
        <text class="label">模拟识别文本</text>
        <input
          class="mock-input"
          value="{{mockText}}"
          bindinput="onMockTextInput"
          placeholder="mock 按住说话松开后的识别结果"
          aria-label="模拟识别文本"
        />
      </view>
      <view class="hint">mock 模式：地图页按住说话松开后，以上方文本作为识别结果提交意图。</view>
    </block>
  </view>

  <view class="section">
    <view class="section-title">状态</view>
    <view class="row"><text class="label">地图版本</text><text>{{mapVersion}}</text></view>
    <view class="row" wx:if="{{downloadText !== ''}}">
      <text class="label">地图下载</text><text>{{downloadText}}</text>
    </view>
    <view class="row"><text class="label">登录状态</text><text user-select>{{tokenStatus}}</text></view>
    <view class="row"><text class="label">TTS 引擎</text><text>{{ttsEngine}}</text></view>
    <view class="row"><text class="label">ASR 引擎</text><text>{{asrEngine}}</text></view>
  </view>

  <view class="section">
    <view class="section-title">标定模式（现场工具）</view>
    <view class="row">
      <text class="label">记录可信位置估计</text>
      <switch checked="{{calibrationSetting}}" bindchange="onChangeCalibrationMode" aria-label="切换标定模式是否记录轨迹" />
    </view>
    <view class="hint">开启后只把可信位置估计（含可见信标数、指令序号、会话状态）写入本地缓冲，<text style="color:#1f2937">不改定位/导航算法与播报</text>；重启小程序生效。本次启动：{{calibrationMode ? '已记录' : '未记录'}}。</view>
    <view class="row">
      <text class="label">操作人</text>
      <input class="mock-input" value="{{calibrationOperator}}" bindinput="onCalibrationOperatorInput" placeholder="姓名/工号" aria-label="标定操作人" />
    </view>
    <view class="row"><text class="label">已记录</text><text>{{calibrationCount}} 条</text></view>
    <button class="action" bindtap="onExportCalibration" aria-label="导出标定记录">导出标定记录</button>
    <button class="action danger" bindtap="onClearCalibration" aria-label="清空标定记录">清空标定记录</button>
    <view wx:if="{{calibrationExportPath}}" class="hint" user-select>{{calibrationExportPath}}</view>
  </view>

  <view class="section">
    <view class="section-title">自检</view>
    <view class="result" aria-live="polite" wx:if="{{selfTestResult !== ''}}">{{selfTestResult}}</view>
    <button class="action" bindtap="onSelfTestTts" disabled="{{busy}}" aria-label="语音自检">语音自检</button>
    <button class="action secondary" bindtap="onReloadMap" disabled="{{busy}}" aria-label="重新加载地图">重新加载地图</button>
    <button class="action danger" bindtap="onClearCache" aria-label="清除本地缓存">清除本地缓存</button>
  </view>
</view>
