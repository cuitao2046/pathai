.page {
  padding: 48rpx 32rpx;
}

.section {
  margin-bottom: 48rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #374151;
}

.label {
  flex-shrink: 0;
  color: #6b7280;
}

.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.result {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  font-size: 26rpx;
  line-height: 1.6;
  color: #374151;
}

.mock-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  font-size: 26rpx;
}

.action {
  margin-top: 24rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
}

.action.secondary {
  background: #eef4ff;
  color: #1a56db;
}

.action.danger {
  background: #fef2f2;
  color: #dc2626;
}
