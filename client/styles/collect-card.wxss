/* 采集页底部点位面板 */
.card {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 6;
  background: #ffffff;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -2px 12px rgba(15, 23, 42, 0.18);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.card-row {
  display: flex;
  font-size: 26rpx;
  padding: 6rpx 0;
  color: #1f2937;
}

.card-row .label {
  flex: 0 0 160rpx;
  color: #64748b;
}

.card-row .label.wall-label-0 {
  color: #9d174d;
}

.card-row .label.wall-label-1 {
  color: #0f766e;
}

.card-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b45309;
  background: #fffbeb;
  border-radius: 8rpx;
  padding: 12rpx;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  border-radius: 12rpx;
  line-height: 2.4;
}

.btn.primary {
  background: #1a56db;
  color: #ffffff;
}

.btn.ghost {
  background: #f1f5f9;
  color: #1f2937;
}
