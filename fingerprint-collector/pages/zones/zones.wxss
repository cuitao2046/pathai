.zone { padding: 20rpx 24rpx; }
.zone-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.zone-name { font-size: 32rpx; font-weight: 600; margin-right: 12rpx; }
.zone-id { color: var(--muted); font-size: 24rpx; }
.zone-ops { display: flex; gap: 16rpx; margin-top: 14rpx; }
.zone-ops .btn { flex: 1; margin: 0; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; z-index: 50; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 28rpx 28rpx 40rpx; max-height: 88vh; overflow-y: auto; }
.sheet-title { font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; }
.form-row { margin-bottom: 22rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--muted); margin-bottom: 8rpx; }
.anchor-picked { margin-top: 10rpx; padding: 10rpx 14rpx; background: #ecfdf5; color: #047857; border-radius: 8rpx; font-size: 24rpx; }
.anchor-hint { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; }
.anchor-list { max-height: 38vh; margin-top: 12rpx; border: 1rpx solid #e5e7eb; border-radius: 10rpx; }
.anchor-item { display: flex; justify-content: space-between; padding: 14rpx 18rpx; border-bottom: 1rpx solid #f1f5f9; font-size: 24rpx; }
.anchor-item:last-child { border-bottom: none; }
.sheet-ops { display: flex; gap: 16rpx; margin-top: 8rpx; }
.sheet-ops .btn { flex: 1; margin: 0; }
