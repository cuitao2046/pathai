.search { margin: 16rpx 0; }
.search input {
  height: 72rpx; border: 1rpx solid #d1d5db; border-radius: 10rpx;
  padding: 0 20rpx; background: #fff;
}
.chips { display: flex; gap: 16rpx; }
.chip {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 999rpx;
  background: #eef2ff; color: var(--primary); font-size: 26rpx;
}
.chip.on { background: var(--primary); color: #fff; }

.pt {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; background: #fff; border-radius: 12rpx; margin-bottom: 12rpx;
}
.pt:active { background: #f1f5f9; }
.pt-main { display: flex; flex-direction: column; gap: 6rpx; }
.pt-id { font-weight: 600; }
.pt-right { margin-left: 12rpx; }
.empty { text-align: center; color: var(--muted); padding: 40rpx; }
